nu Layanan, pilih jenis surat yang dibutuhkan, isi formulir beserta data pendukung, lalu kirim. Anda akan menerima nomor tiket untuk memantau status pengajuan.";s:3:"url";s:37:"https://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}i:1;a:4:{s:5:"title";s:35:"Berapa lama surat selesai diproses?";s:4:"desc";s:160:"Sebagian besar surat selesai dalam 1 hari kerja setelah data dinyatakan lengkap. Surat tertentu seperti keterangan ahli waris dapat memerlukan waktu lebih lama.";s:3:"url";s:37:"https://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}i:2;a:4:{s:5:"title";s:40:"Apakah pengurusan surat dikenakan biaya?";s:4:"desc";s:87:"Tidak. Seluruh layanan administrasi surat di Kantor Desa tidak dipungut biaya (gratis).";s:3:"url";s:37:"https://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}i:3;a:4:{s:5:"title";s:47:"Bagaimana cara mengecek status pengajuan surat?";s:4:"desc";s:100:"Buka halaman Cek Status Layanan, lalu masukkan nomor tiket yang Anda terima saat mengirim pengajuan.";s:3:"url";s:37:"https://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}i:4;a:4:{s:5:"title";s:32:"Kapan jam pelayanan Kantor Desa?";s:4:"desc";s:126:"Pelayanan tatap muka dibuka pada hari kerja, Senin sampai Jumat. Jadwal lengkap tercantum di bagian kontak pada bawah halaman.";s:3:"url";s:37:"https://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}}}}s:5:"total";i:19;}}