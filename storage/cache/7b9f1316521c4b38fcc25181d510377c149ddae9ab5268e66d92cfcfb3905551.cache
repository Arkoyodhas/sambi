yampaikan pengaduan atau aspirasi?";s:4:"desc";s:156:"Gunakan menu Pengaduan untuk mengirim aduan beserta foto pendukung. Pengaduan dapat dilacak dengan nomor tiket dan akan ditindaklanjuti oleh perangkat desa.";s:3:"url";s:37:"https://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}}}}s:5:"total";i:8;}}