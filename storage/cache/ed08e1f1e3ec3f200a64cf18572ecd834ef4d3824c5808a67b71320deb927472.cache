esa.id/pemerintahan";s:4:"meta";s:14:"Kasi Pelayanan";}}}i:4;a:4:{s:3:"key";s:3:"faq";s:5:"label";s:11:"Tanya Jawab";s:4:"icon";s:17:"bi-patch-question";s:5:"items";a:4:{i:0;a:4:{s:5:"title";s:32:"Kapan jam pelayanan Kantor Desa?";s:4:"desc";s:126:"Pelayanan tatap muka dibuka pada hari kerja, Senin sampai Jumat. Jadwal lengkap tercantum di bagian kontak pada bawah halaman.";s:3:"url";s:36:"http://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}i:1;a:4:{s:5:"title";s:46:"Bagaimana cara mengajukan surat secara online?";s:4:"desc";s:166:"Buka menu Layanan, pilih jenis surat yang dibutuhkan, isi formulir beserta data pendukung, lalu kirim. Anda akan menerima nomor tiket untuk memantau status pengajuan.";s:3:"url";s:36:"http://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}i:2;a:4:{s:5:"title";s:40:"Apakah pengurusan surat dikenakan biaya?";s:4:"desc";s:87:"Tidak. Seluruh layanan administrasi surat di Kantor Desa tidak dipungut biaya (gratis).";s:3:"url";s:36:"http://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}i:3;a:4:{s:5:"title";s:47:"Bagaimana cara mengecek status pengajuan surat?";s:4:"desc";s:100:"Buka halaman Cek Status Layanan, lalu masukkan nomor tiket yang Anda terima saat mengirim pengajuan.";s:3:"url";s:36:"http://dawung-sambirejo.desa.id/#faq";s:4:"meta";s:3:"FAQ";}}}}s:5:"total";i:12;}}