a:2:{s:7:"expires";i:1795466207;s:5:"value";a:6:{i:0;a:3:{s:2:"id";s:1:"1";s:8:"question";s:46:"Bagaimana cara mengajukan surat secara online?";s:6:"answer";s:166:"Buka menu Layanan, pilih jenis surat yang dibutuhkan, isi formulir beserta data pendukung, lalu kirim. Anda akan menerima nomor tiket untuk memantau status pengajuan.";}i:1;a:3:{s:2:"id";s:1:"2";s:8:"question";s:35:"Berapa lama surat selesai diproses?";s:6:"answer";s:160:"Sebagian besar surat selesai dalam 1 hari kerja setelah data dinyatakan lengkap. Surat tertentu seperti keterangan ahli waris dapat memerlukan waktu lebih lama.";}i:2;a:3:{s:2:"id";s:1:"3";s:8:"question";s:40:"Apakah pengurusan surat dikenakan biaya?";s:6:"answer";s:87:"Tidak. Seluruh layanan administrasi surat di Kantor Desa tidak dipungut biaya (gratis).";}i:3;a:3:{s:2:"id";s:1:"4";s:8:"question";s:47:"Bagaimana cara mengecek status pengajuan surat?";s:6:"answer";s:100:"Buka halaman Cek Status Layanan, lalu masukkan nomor tiket yang Anda terima saat mengirim pengajuan.";}i:4;a:3:{s:2:"id";s:1:"5";s:8:"question";s:52:"Bagaimana cara menyampaikan pengaduan atau aspirasi?";s:6:"answer";s:156:"Gunakan menu Pengaduan untuk mengirim aduan beserta foto pendukung. Pengaduan dapat dilacak dengan nomor tiket dan akan ditindaklanjuti oleh perangkat desa.";}i:5;a:3:{s:2:"id";s:1:"6";s:8:"question";s:32:"Kapan jam pelayanan Kantor Desa?";s:6:"answer";s:126:"Pelayanan tatap muka dibuka pada hari kerja, Senin sampai Jumat. Jadwal lengkap tercantum di bagian kontak pada bawah halaman.";}}}